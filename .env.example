# ---- Supabase (project: architecture-jobs, ref sdxteghszuqscbnpjpnz, eu-west-2) ----
NEXT_PUBLIC_SUPABASE_URL=https://sdxteghszuqscbnpjpnz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Worker DB connection. Railway is IPv4-only: use the Supavisor SESSION pooler (port 5432), never
# transaction mode (6543, breaks pg-boss) and never the IPv6 direct host.
SUPABASE_DB_URL=postgres://postgres.sdxteghszuqscbnpjpnz:[DB_PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# ---- Security ----
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=
# Any outbound email is simulated while true. Keep true until the Gmail flow is proven.
OUTREACH_DRY_RUN=true

# ---- Google (Gmail OAuth + Routes API) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_MAPS_API_KEY=
# Mailbox that must be connected (the OAuth callback rejects any other account)
OUTREACH_MAILBOX=

# ---- AI ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Job sources (each source stays disabled until its key is present) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
COMPANIES_HOUSE_API_KEY=
TFL_APP_KEY=

# ---- Worker ----
WORKER_USER_AGENT=AJIS/1.0 (+mailto:you@example.com)
WORKER_LOG_LEVEL=info
